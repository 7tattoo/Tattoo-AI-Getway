<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="14dp">

        <TextView
            android:id="@+id/loginTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="登录"
            android:textSize="16sp"
            android:textColor="#222222"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/loginStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="准备登录..."
            android:textSize="13sp"
            android:textColor="#666666" />
    </LinearLayout>

    <Button
        android:id="@+id/loginSwitchBtn"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:text="换登录页(1/4)"
        android:textSize="12sp"
        android:textColor="@color/text_primary"
        android:background="@drawable/bg_btn_secondary"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:visibility="gone"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/loginCheckBtn"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:text="检测登录状态"
        android:textSize="12sp"
        android:textColor="@color/text_primary"
        android:background="@drawable/bg_btn_secondary"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textAllCaps="false" />

    <WebView
        android:id="@+id/loginWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>